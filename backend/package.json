{
  "name": "@nexclean/backend",
  "private": true,
  "version": "0.0.0",
  "description": "NexClean API — Node + Express + TypeScript + MongoDB, role-based modules.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "test-start": "node --import tsx src/index.ts",
    "cleanup": "node --import tsx src/scripts/cleanup.ts",
    "delete-customers": "node --import tsx src/scripts/delete-all-customers.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.6",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.2": true
  }
}
