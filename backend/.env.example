# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/nexclean

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MIN=5
# Demo code that bypasses OTP for ANY phone number. Development only — in
# production it is ignored, and the server refuses to boot with it set, unless
# ALLOW_DEMO_LOGIN=true below.
DEMO_OTP=123456

# Keeps DEMO_OTP and the default ADMIN_PASSWORD working on a host that is
# flagged NODE_ENV=production but is still a demo. Needed when no SMS provider
# is configured, because OTP is the only login path for customers and cleaners.
# While this is on, anyone who knows the demo code can sign in as any phone
# number — the server prints a warning on every boot. Remove it before
# onboarding real customers. JWT_SECRET is never waived by this flag.
ALLOW_DEMO_LOGIN=

# CORS — frontend origin(s). Comma-separate multiple (e.g. prod + preview URLs).
# Trailing slashes are tolerated. Use "*" to allow any origin (not for prod).
CLIENT_ORIGIN=http://localhost:5173

# Firebase Cloud Messaging (optional).
# Base64-encode your service-account JSON: base64 -i serviceAccount.json
# When unset, push notifications run in mock mode (logged to the server console).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Collection mode.
# The product today is pay-to-cleaner: the customer confirms in the app and
# hands cash to the cleaner after the service. Leave this false for that.
# Set to true ONLY when you want online checkout, and supply live Razorpay
# keys below. This is deliberately a separate switch — deriving it from "are
# keys present?" put the server into online mode while the app still sent no
# payment fields, and every booking failed with 400.
PAYMENTS_ONLINE=false

# Razorpay. Only used when PAYMENTS_ONLINE=true.
# A production boot with PAYMENTS_ONLINE=true is rejected if these are missing
# or still an rzp_test_ key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (optional). Credentials for media upload.
# When unset, uploads run in mock mode (using default fallback URLs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo admin login (seeded on startup)
ADMIN_EMAIL=superadmin@gmail.com
ADMIN_PASSWORD=password123

# Real-time dispatch tuning (all optional — sensible defaults shown).
# OFFER_TTL: seconds a cleaner has to accept before the job moves to the next.
DISPATCH_OFFER_TTL_MS=60000
# Search rings in metres — dispatch widens through these before giving up.
DISPATCH_RADII_M=3000,6000,12000
# Cleaners offered a job at once (1 = strict sequential nearest-first).
DISPATCH_OFFER_BATCH=1
# How often the worker sweeps expired offers.
DISPATCH_SWEEP_INTERVAL_MS=2000
# How far ahead of a subscription wash's slot to auto-assign the nearest cleaner.
DISPATCH_SUBSCRIPTION_LEAD_MS=7200000

# SMSINDIAHUB Integration
# Either set SMS_INDIA_HUB_API_KEY OR set both USER and PASSWORD
SMS_INDIA_HUB_USER=
SMS_INDIA_HUB_PASSWORD=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=BGADEC
# DLT parameters
SMS_INDIA_HUB_ENTITY_ID=
SMS_INDIA_HUB_TEMPLATE_ID=
SMS_INDIA_HUB_GWID=2
# Approved DLT text template. Keep {{otp}} placeholder for the actual code.
SMS_INDIA_HUB_TEMPLATE="Welcome to the NexClean powered by Appzeto.Your OTP for registration is {{otp}}.BGADEC"

# Include stack traces in API error responses. Debugging aid, never on in
# production (the flag is ignored when NODE_ENV=production).
DEBUG_ERRORS=false
