# Base URL of the NexClean API (no trailing slash).
# Local dev default is http://localhost:4000/api — set this in production
# (e.g. your deployed backend) via Vercel env vars.
VITE_API_URL=http://localhost:4000/api

# Google Maps JavaScript API key.
#
# Enable these APIs on the key's project, or the corresponding feature silently
# degrades rather than erroring:
#   Maps JavaScript API  — the live tracking maps themselves
#   Places API           — address autocomplete during booking
#   Geocoding API        — reverse-geocoding the pin the customer drops
#   Directions API       — the route line and the real driving ETA
#
# The key must also be billing-enabled and allow this deployment's origin as a
# referrer. A key that is missing, unbilled, or referrer-blocked makes every map
# surface fall back to a schematic view: tracking still works and the distances
# are still real, but there is no basemap and no road route. Watch the browser
# console for "[maps] Google rejected the Maps API key" — that is this exact
# situation, and it is otherwise easy to mistake for a broken map.
#
# Without a key at all, addresses save without coordinates and bookings fall
# back to manual assignment in the admin Dispatch console.
VITE_GOOGLE_MAPS_KEY=

# Firebase Cloud Messaging — web push config (all optional).
# When these are set (together with FIREBASE_SERVICE_ACCOUNT_BASE64 on the
# backend), the apps register a real FCM token and receive OS-level push
# notifications — including job offers for cleaners when the app is
# backgrounded. When unset, a synthetic token is used and push runs in mock
# mode (logged on the server). Values come from Firebase console →
# Project settings → General (web app config) and → Cloud Messaging (VAPID key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Cloud Messaging → Web configuration).
VITE_FIREBASE_VAPID_KEY=
