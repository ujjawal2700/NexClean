# Base URL of the NexClean API (no trailing slash).
# Local dev default is http://localhost:4000/api — set this in production
# (e.g. your deployed backend) via Vercel env vars.
VITE_API_URL=http://localhost:4000/api

# Google Maps JavaScript API key (Places + Geocoding).
# Powers address autocomplete and captures the lat/lng used to rank the
# nearest cleaner. Without it, addresses save without coordinates and bookings
# fall back to manual assignment in the admin Dispatch console.
VITE_GOOGLE_MAPS_KEY=

# Firebase Cloud Messaging — web push config (all optional).
# When these are set (together with FIREBASE_SERVICE_ACCOUNT_BASE64 on the
# backend), the apps register a real FCM token and receive OS-level push
# notifications — including job offers for cleaners when the app is
# backgrounded. When unset, a synthetic token is used and push runs in mock
# mode (logged on the server). Values come from Firebase console →
# Project settings → General (web app config) and → Cloud Messaging (VAPID key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Cloud Messaging → Web configuration).
VITE_FIREBASE_VAPID_KEY=
