# Base URL of the NexClean API (no trailing slash).
# Local dev default is http://localhost:4000/api — set this in production
# (e.g. your deployed backend) via Vercel env vars.
VITE_API_URL=http://localhost:4000/api

# Browser SDK configuration is fetched from /api/config/public at runtime.
# Configure Maps and Firebase only in backend/.env; never place credentials in
# a VITE_* variable because Vite embeds every referenced value in the bundle.
