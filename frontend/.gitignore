.vite

# Compiled output of vite.config.ts. Vite resolves vite.config.js BEFORE
# vite.config.ts, so a stale emitted copy silently shadows the real config —
# edits to the .ts then have no effect at all. tsconfig.node.json sets
# noEmit, so these only appear from an ad-hoc `tsc`; keep them out of git.
vite.config.js
vite.config.d.ts

